# =========================================================
# Cybersecurity Big Data Platform — Environment Variables
# =========================================================

# --- Project ---
PROJECT_NAME=cybersecurity-bigdata-platform
PROJECT_VERSION=1.0.0

# --- Kafka ---
KAFKA_BOOTSTRAP_INTERNAL=kafka1:19092,kafka2:19093,kafka3:19094
KAFKA_BOOTSTRAP_EXTERNAL=localhost:9092,localhost:9093,localhost:9094
KAFKA_TOPIC=unsw-nb15
KAFKA_PARTITIONS=3
KAFKA_REPLICATION=2
KAFKA_MESSAGE_MAX_BYTES=5242880

# --- NiFi ---
NIFI_USERNAME=admin
NIFI_PASSWORD=admin123456789
NIFI_URL=https://localhost:7443

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cybersecurity
POSTGRES_USER=postgres
POSTGRES_PASSWORD=itversity
POSTGRES_TABLE=unsw_nb15

# --- Spark ---
SPARK_MASTER=local[*]
SPARK_APP_NAME=UNSW-NB15-Analysis
SPARK_HOME=/opt/spark

# --- Paths (inside container) ---
DATA_RAW=/workspace/data/raw
DATA_STAGING=/workspace/data/staging
DATA_REJECTED=/workspace/data/rejected
DATA_CURATED=/workspace/data/curated
DATA_NOTEBOOKS=/workspace/data/notebooks

# --- Dataset ---
DATASET_NAME=UNSW-NB15
DATASET_SIZE_MB=642
DATASET_FILES=7
DATASET_COLUMNS=49